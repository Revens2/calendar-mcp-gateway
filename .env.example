# Variables d'environnement de la passerelle Calendar — DOCUMENTATION UNIQUEMENT.
# Le fichier réel (calendar.env, 0600, propriété du compte de service) est créé par
# deploy/install-gateway.sh ; jamais versionné.

# Port d'écoute de la passerelle (boucle locale ; nginx est le point d'entrée externe)
CALENDAR_MCP_PORT=8790

# Issuer OAuth : URL HTTPS publique (exemple)
CALENDAR_MCP_ISSUER=

# URL du serveur MCP upstream (conteneur google-calendar-mcp, boucle locale)
CALENDAR_MCP_UPSTREAM=http://127.0.0.1:3000

# Jeton Bearer statique pour les clients CLI + scopes
CALENDAR_MCP_TOKEN=
CALENDAR_MCP_TOKEN_SCOPES=calendar:lecture calendar:ecriture

# Empreinte PBKDF2 de la phrase de consentement OAuth
CALENDAR_MCP_CONSENT_HASH=
